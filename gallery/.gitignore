# Gallery images are deployed to the gh-pages branch only.
# A clone of main must never pull ~200 MB of samples.
images/

# Deployment output, rebuilt from the actual published images by publish.py.
# Keep it on gh-pages; a checked-in main-branch snapshot silently goes stale.
*/manifest.json

# Scratch output from cross_reference.py. Regenerate on demand, never commit.
missing.txt
orphans.txt
extra.txt
# Scratch renders from scripts/render_gallery.py. Fetched from ComfyUI, then
# published to gh-pages by publish.py - never committed to main.
.render_out/
